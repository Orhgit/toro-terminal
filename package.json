{
  "name": "toro-platform",
  "private": true,
  "bin": {
    "toro": "./bin/toro.sh"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "sync-linear": "tsx scripts/sync-linear.ts",
    "predeploy": "pnpm check-types && pnpm lint && pnpm test && pnpm build",
    "deploy": "git status --porcelain && echo '↑ inspect changes, then run: git push' && exit 1"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.19.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
