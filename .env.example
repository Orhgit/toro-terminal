# Toro Platform — Environment Variables
# Copy this file to .env and fill in your keys

# OpenAI (powers the AI Swarm)
OPENAI_API_KEY=

# Supabase (database)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Linear (marketing task sync)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Mapbox (3D map in web portal)
NEXT_PUBLIC_MAPBOX_TOKEN=

# WhatsApp (webhook gateway)
WHATSAPP_VERIFY_TOKEN=

# Server
PORT=4002
HOST=0.0.0.0
